@page "/lexicon"
@using System.Collections.ObjectModel
@rendermode InteractiveServer
@inject ILexiconService LexiconService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Lexicon</PageTitle>

<MudPaper Width="100%" Square="true" Elevation="0" Class="d-inline-flex pa-4 gap-4 object-contain" Style="height: calc(100vh - 64px);">

    <!-- SEARCH GRID -->
    <MudDataGrid @ref="@grid" T="LexicalEntry" Items="@LexiconData" FixedHeader="true" Elevation="1"
                 SortMode="SortMode.Single" Dense="true" ColumnResizeMode="ResizeMode.Column"
                 SelectOnRowClick="true" SelectedItemChanged="OnSelectedItemChanged"
                 Class="flex-grow-2 cursor-pointer pa-2 flex-column d-flex" Hover="true" Height="calc(100% - 1px)">

        <ToolBarContent>
            <!-- SEARCHBAR -->
            <MudTextField T="string"
                          Placeholder="Search word..."
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" ValueChanged="OnLexiconSearch" />
            <!-- NEW ENTRY BUTTON "+" -->
            <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="OnNewEntryClick" />
        </ToolBarContent>

        <Columns>
            <SelectColumn T="LexicalEntry" />
            <PropertyColumn Property="x => x.Word" Title="Word" />
            <PropertyColumn Property="x => x.Conlang" Title="Colang" />
            <!-- COMMAND COLUMN -->
            <TemplateColumn CellClass="d-flex justify-end">
                <CellTemplate>
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => OnDeleteEntryClick(context.Item) )" Color="Color.Secondary" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>

        <PagerContent>
            <MudDataGridPager T="LexicalEntry" PageSizeOptions="new[] {50}" PageSizeSelector="false" />
        </PagerContent>

    </MudDataGrid>

    <!-- EDITFORM -->
    <MudCard Class="flex-grow-1 pa-2 d-flex flex-column">
        <MudCardContent Class="flex-grow-1 overflow-auto">
            <MudText Align="Align.Center">Details</MudText>
            <MudForm Model="@EditModel" @ref="@form" Spacing="2">
                <!-- WORD FIELD -->
                <MudTextField @bind-Value="EditModel.Word"
                              For="@(() => EditModel.Word)"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Label="Word" OnlyValidateIfDirty="false" />

                <!-- COLANG FIELD -->
                <MudTextField @bind-Value="EditModel.Conlang"
                              For="@(() => EditModel.Conlang)"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Label="Conlang" />

                <!-- WORDTYPE FIELD -->
                <MudSelect T="WordType?"
                           @bind-Value="EditModel.WordType"
                           For="@(() => EditModel.WordType)"
                           Variant="Variant.Outlined"
                           Label="WordType"
                           FitContent="false">

                    @foreach (WordType wordType in Enum.GetValues<WordType>())
                    {
                        <MudSelectItem T="WordType?" Value="wordType">
                            @wordType
                        </MudSelectItem>
                    }

                </MudSelect>

                <!-- PRONUNCIATION FIELD -->
                <MudTextField T="string" @bind-Value="EditModel.Pronunciation"
                              For="@(() => EditModel.Pronunciation)"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Label="Pronunciation" />

                <!-- DEFINITION FIELD -->
                <MudTextField T="string" @bind-Value="EditModel.Definition"
                              For="@(() => EditModel.Definition)"
                              Label="Definition"
                              Variant="Variant.Outlined"
                              Lines="10"
                              MaxLines="10"
                              MaxLength="700"
                              Sizing="InputSizing.Auto" />

                <!-- ETIMOLOGY FIELD -->
                <MudCard Elevation="0" Outlined="true" Class="d-flex flex-column flex-grow-1">
                    <MudCardHeader>
                        <MudText Align="Align.Left">Etimology</MudText>
                        <MudSpacer />
                        <!-- ADD ETIMOLOGY BUTTON -->
                        <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="@(() =>  OnEtimologyPopUp())" />
                    </MudCardHeader>
                    <MudCardContent Class="d-flex flex-row">
                        @if (EditModel.Etimology.Count > 0)
                        {
                            @foreach (var item in EditModel.Etimology)
                            {
                                <MudChip T="string" OnClick="@(() => OnSelectedItemChanged(item))" OnClose="@(() => OnChipDelete(item, EditModel.Etimology))">@item.Conlang</MudChip>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.subtitle1" Style="@($"color: {Colors.Gray.Default};")">There are no roots to the word.</MudText>
                        }

                    </MudCardContent>
                </MudCard>

            </MudForm>
        </MudCardContent>
        <MudCardActions>
            <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" OnClick="TrySubmit">Save Changes</MudButton>
        </MudCardActions>
    </MudCard>
</MudPaper>

<MudOverlay @bind-Visible="OverlayVisible" DarkBackground>
    <MudCard Style="width: 100%;">
        <MudCardContent>
            <MudText Typo="Typo.h6">Etimology Roots</MudText>
            <!-- SEARCH GRID -->
            <MudDataGrid @ref="@grid" T="LexicalEntry" Items="@EtimologyData" FixedHeader="true" Elevation="0"
                         SortMode="SortMode.Single" Dense="true" ColumnResizeMode="ResizeMode.Column"
                         SelectOnRowClick="true"
                         Class=" cursor-pointer flex-column d-flex" Hover="true" Height="300px" Outlined>

                <ToolBarContent>
                    <!-- SEARCHBAR -->
                    <MudTextField T="string"
                                  Placeholder="Search word..."
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" ValueChanged="OnEtimologySearch" />
                </ToolBarContent>

                <Columns>
                    <PropertyColumn Property="x => x.Word" Title="Word" />
                    <PropertyColumn Property="x => x.Conlang" Title="Colang" />

                    <TemplateColumn CellClass="d-flex justify-end">
                        <CellTemplate>
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Add" OnClick="@(() => OnAddEtimology(context.Item))" Color="Color.Secondary" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="LexicalEntry" PageSizeOptions="new[] {50}" PageSizeSelector="false" />
                </PagerContent>

            </MudDataGrid>
        </MudCardContent>
        <MudCardActions>
            <MudButton OnClick="@(() => OnSaveEtimology())">Save</MudButton>
            <MudSpacer />
            <MudButton OnClick="@(() => OverlayVisible = false)">Close</MudButton>
        </MudCardActions>
    </MudCard>

</MudOverlay>

@code {

    #region Fields

    private bool OverlayVisible = false;

    MudForm form { get; set; } = null!;
    MudDataGrid<LexicalEntry> grid { get; set; } = null!;

    private LexicalEntry? SelectedModel = new();
    private LexicalEntry EditModel = new();

    private string LexiconSearch = string.Empty;
    private string EtimologySearch = string.Empty;

    private ObservableCollection<LexicalEntry> LexiconData = new();
    private ObservableCollection<LexicalEntry> EtimologyData = new();

    private HashSet<LexicalEntry> EtimologyCache = new HashSet<LexicalEntry>();

    #endregion


    #region Lifecycle

    protected override void OnInitialized()
    {
        // Datos de prueba
        var c0 = new LexicalEntry() { Word = "Forzar", Conlang = "Tharvir" };
        var c1 = new LexicalEntry() { Word = "Fuerza", Conlang = "Thar" };
        var c2 = new LexicalEntry() { Word = "Experimentalmente", Conlang = "Exprensadaviralis" };
        var c3 = new LexicalEntry() { Word = "Hola", Conlang = "Vay" };

        c0.Etimology.Add(c1);

        for (int i = 0; i < 2000; i++)
        {
            LexiconService.Add(new LexicalEntry() { Word = i.ToString(), Conlang = i.ToString() });
        }

        LoadData();

        SelectedModel = LexiconData.FirstOrDefault();
    }

    #endregion


    #region Search Grid

    private void LoadData()
    {
        LexiconData.Clear();

        foreach (var item in LexiconService.GetAll())
        {
            LexiconData.Add(item);
        }
    }

    private void OnLexiconSearch(string text)
    {
        LexiconSearch = text;

        LexiconData.Clear();

        var results = string.IsNullOrWhiteSpace(LexiconSearch)
            ? LexiconService.GetAll()
            : LexiconService.Search(LexiconSearch);

        foreach (var item in results)
        {
            LexiconData.Add(item);
        }
    }

    private void OnEtimologySearch(string text)
    {
        EtimologySearch = text;

        EtimologyData.Clear();

        if (string.IsNullOrWhiteSpace(EtimologySearch))
            return;

        foreach (var item in LexiconService.Search(EtimologySearch))
        {
            EtimologyData.Add(item);
        }
    }

    #endregion


    #region Selection & CRUD

    private void OnSelectedItemChanged(LexicalEntry entry)
    {
        if (entry != null)
        {
            EditModel.Id = entry.Id;
            EditModel.Word = entry.Word;
            EditModel.Conlang = entry.Conlang;
            EditModel.WordType = entry.WordType;
            EditModel.Pronunciation = entry.Pronunciation;
            EditModel.Definition = entry.Definition;
            EditModel.Etimology = entry.Etimology;
        }
    }

    private void OnNewEntryClick()
    {
        EditModel = new LexicalEntry();
        SelectedModel = EditModel;
        StateHasChanged();
    }

    private async Task OnDeleteEntryClick(LexicalEntry entry)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Warning",
            "Deleting can not be undone!",
            yesText: "Delete", cancelText: "Cancel");

        if (result == null || result == false) return;

        LexiconService.Remove(entry);
        LoadData();
    }

    private void OnEditEntryClick(LexicalEntry entry)
    {
        EditModel = entry;
    }

    #endregion


    #region Etimology

    private void OnChipDelete(LexicalEntry entry, HashSet<LexicalEntry> etimologyList)
    {
        etimologyList.Remove(entry);
    }

    private void OnEtimologyPopUp()
    {
        OverlayVisible = true;
    }

    private void OnSaveEtimology()
    {
        if (EditModel == null)
        {
            OverlayVisible = false;
            return;
        }

        // AddRange equivalent for HashSet
        foreach (var item in EtimologyCache)
        {
            EditModel.Etimology.Add(item); // won't add duplicates
        }

        EtimologyCache.Clear();
        OverlayVisible = false;
        StateHasChanged();
    }

    private void OnAddEtimology(LexicalEntry entry)
    {
        EtimologyCache.Add(entry);
    }

    #endregion


    #region MudForm

    private void TrySubmit()
    {
        if (EditModel == null)
        {
            return;
        }

        Snackbar.Clear();

        if (!IsFormValid())
        {
            return;
        }

        LexiconService.Insert(EditModel);
        LoadData();

        Snackbar.Add("New Entry Added!", Severity.Success);

        EditModel = new LexicalEntry();
    }

    private bool IsFormValid()
    {
        if (string.IsNullOrEmpty(EditModel.Word))
        {
            Snackbar.Add("Word field Cannot be empty.", Severity.Error);
            return false;
        }

        return true;
    }

    #endregion
}
